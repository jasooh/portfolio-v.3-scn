# copy to .env.local for local dev, and set the same keys in vercel

# sanity (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=891d4d3u
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=

# formspree form id for the contact form
NEXT_PUBLIC_FORM=

# spotify "last played" row (optional: the row is hidden when unset)
# get the refresh token once with scripts/spotify-auth.mjs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# live valorant rank, headshot % and last match (optional: falls back to sanity)
# key from https://api.henrikdev.xyz/dashboard/
HENRIKDEV_API_KEY=
VALORANT_NAME=
VALORANT_TAG=
# na, eu, ap, kr, latam or br
VALORANT_REGION=na
