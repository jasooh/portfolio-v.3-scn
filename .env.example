# copy to .env.local for local dev, and set the same keys in vercel

# sanity (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=891d4d3u
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=

# formspree form id for the contact form
NEXT_PUBLIC_FORM=

# spotify "now playing" tile (optional: the tile is hidden when unset)
# get the refresh token once with scripts/spotify-auth.mjs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
